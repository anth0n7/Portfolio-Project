---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; flip?: boolean; }
const { project, flip = false } = Astro.props;
const { title, kind, summary, tech, links, cover, coverAlt } = project.data;
---
<article class:list={['grid items-center gap-8 md:grid-cols-2', flip && 'md:[&>*:first-child]:order-2']}>
  <a href={`/projects/${project.id}`} class="group block" aria-label={cover ? `${title} case study` : `${title} case study. Demo video coming soon`}>
    {cover ? (
      <Image
        src={cover}
        alt={coverAlt ?? title}
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 480px, 100vw"
        class="aspect-[4/3] w-full rounded-xl border border-line object-cover object-top shadow-[0_20px_50px_-30px_rgba(0,0,0,.35)] transition duration-300 group-hover:-translate-y-1"
      />
    ) : (
      <div class="grid aspect-[4/3] place-items-center rounded-xl border border-dashed border-line bg-surface px-6 text-center text-sm text-muted">
        Demo video coming soon
      </div>
    )}
  </a>
  <div>
    <p class="font-mono text-xs uppercase tracking-[.14em] text-accent-strong">{kind}</p>
    <h3 class="mt-2 text-3xl font-semibold tracking-tight">{title}</h3>
    <p class="mt-3 text-muted">{summary}</p>
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Built with">
      {tech.map((t) => <li class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted">{t}</li>)}
    </ul>
    <div class="mt-6 flex flex-wrap gap-3 text-sm">
      <a href={`/projects/${project.id}`} class="rounded-lg bg-accent-strong px-4 py-2 font-medium text-on-accent hover:brightness-110">Read case study →</a>
      {links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-line bg-surface px-4 py-2 hover:border-fg">{l.label} ↗</a>)}
    </div>
  </div>
</article>
